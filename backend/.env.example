# Copie para ".env" dentro de /backend e preencha com valores reais.
# Nunca commitar o ".env".

PORT=3001

# Origin do frontend (Vite dev server) permitida pelo CORS.
ALLOWED_ORIGIN=http://localhost:5173

# --- Superset ---
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=changeme

# UUID do dashboard embedado, obtido no Superset após habilitar "Embed dashboard".
SUPERSET_DASHBOARD_ID=changeme
