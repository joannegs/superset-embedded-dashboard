# Postgres data volume (if ever bind-mounted instead of a named volume)
pgdata/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo
